{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // Two bots update this repository, each owning different pins. Dependabot keeps the
  // workflows' action SHAs and the pre-commit hooks (.github/dependabot.yaml). Renovate owns
  // go.mod whole, the workflows' *_VERSION values, the runner image, CI's Postgres service
  // image and the ko base image.
  // enabledManagers is what keeps them apart: a manager not listed here does not run, so
  // Renovate never edits a file Dependabot owns; github-actions runs only for runner images.
  // Renovate runs from horopter-dev/infrastructure's workflow, whose cron is the only
  // schedule; do not add a `schedule` here.
  extends: ["config:recommended", "customManagers:githubActionsVersions"],
  enabledManagers: ["gomod", "github-actions", "custom.regex"],

  // Policy shared by every horopter-dev repository Renovate updates; keep the copies alike.
  semanticCommits: "enabled",
  dependencyDashboard: true,
  // The same cooldown as Dependabot's. Vulnerability fixes skip it.
  minimumReleaseAge: "7 days",
  // A release with no timestamp, such as an image on a registry other than Docker Hub, is
  // proposed without the cooldown instead of never.
  minimumReleaseAgeBehaviour: "timestamp-optional",
  // The default hourly limit throttles a bot that runs continuously; a cron run is one hour.
  prHourlyLimit: 0,
  prConcurrentLimit: 10,
  osvVulnerabilityAlerts: true,
  vulnerabilityAlerts: {
    // Release Please cuts a release for a fix and none for a chore.
    semanticCommitType: "fix",
    labels: ["security"],
  },

  postUpdateOptions: ["gomodTidy"],

  packageRules: [
    {
      // Never propose a GoReleaser nightly: semver-coerced would drop the -nightly suffix and
      // read v2.20.0-<hash>-nightly as release v2.20.0.
      matchDepNames: ["goreleaser/goreleaser"],
      allowedVersions: "!/-nightly$/",
      versioning: "semver",
    },
    {
      // Majors wait longer: they are the ones that get emergency-patched.
      matchUpdateTypes: ["major"],
      minimumReleaseAge: "14 days",
    },
    {
      // A routine module bump cuts no release. config:recommended types a dependency update
      // as fix(deps), which would release on every one.
      matchManagers: ["gomod"],
      semanticCommitType: "chore",
    },
    {
      // Minors and patches arrive as one pull request, as they did from Dependabot.
      matchManagers: ["gomod"],
      matchDepTypes: ["require", "indirect"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      groupName: "go modules (minor and patch)",
    },
    {
      // The go directive is the Go that CI and releases build with, so it decides the
      // standard library the binaries carry. Renovate leaves it alone unless told to bump it,
      // and a new Go is a fix because it changes what ships.
      matchManagers: ["gomod"],
      matchDepNames: ["go"],
      matchDepTypes: ["golang"],
      rangeStrategy: "bump",
      semanticCommitType: "fix",
    },
    {
      // Action SHAs are Dependabot's; only runs-on images are Renovate's.
      matchManagers: ["github-actions"],
      matchDatasources: ["!github-runners"],
      enabled: false,
    },
    {
      // CI's Postgres stays on the major the compose files name; the two move together, by
      // hand. Digest updates within 18 still arrive.
      matchDepNames: ["postgres"],
      matchUpdateTypes: ["major"],
      enabled: false,
    },
    {
      matchFileNames: [".github/workflows/**"],
      semanticCommitScope: "ci",
    },
  ],

  customManagers: [
    {
      // ko's base image, pinned by digest so a moved tag arrives as a pull request.
      customType: "regex",
      managerFilePatterns: ["/^\\.goreleaser\\.yaml$/"],
      matchStrings: [
        "base_image: (?<depName>[^:\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)",
      ],
      datasourceTemplate: "docker",
    },
    {
      // Service container images in the workflows, pinned by digest the same way. The
      // github-actions manager would find them too, but it runs only for runner images here.
      customType: "regex",
      managerFilePatterns: ["/^\\.github/workflows/[^/]+\\.yaml$/"],
      matchStrings: [
        "image: (?<depName>[^:\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)",
      ],
      datasourceTemplate: "docker",
    },
  ],
}
